*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/

# ==========================================
# 2. IDE & AI Assistants (补齐 Cursor 生态)
# ==========================================
.idea/
.vscode/
.cursor/
.codebuddy/
*.swp
*.swo
.DS_Store

# ==========================================
# 3. 临床数据与配置文件 (强制物理隔离)
