# 优先方案：DeepL Free（每月 50 万字符）
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_API_BASE=https://api-free.deepl.com/v2

# 首选方案：translators 免费通道（无需 key，建议 bing）
TS_TRANSLATOR_ENGINE=bing
TS_SLEEP_SECONDS=0.5

# 翻译方向：en2zh / zh2en
TRANSLATION_DIRECTION=en2zh

# PDF 翻译模式：overlay / bilingual-text-layer
PDF_TRANSLATE_MODE=overlay

# 并发文件数（建议 1-4）
MAX_WORKERS=1

# 持久化缓存文件（加速重复文本翻译）
TRANSLATION_CACHE_FILE=output/translation_cache.json

# 术语词典（json/csv/tsv），优先替换
# GLOSSARY_FILE=input/glossary.json

# 第三兜底：LibreTranslate（公开实例或自建实例）
LIBRETRANSLATE_API_BASE=https://libretranslate.com
# 若实例要求鉴权可填写
# LIBRETRANSLATE_API_KEY=your_libre_key_here

# 翻译引擎选择：auto（默认 translators -> DeepL -> Libre）/ tsfree / deepl / libre
TRANSLATOR_PROVIDER=auto

# 方案 B：访问 Google 翻译需系统/科学代理时，写入其一即可（也会在 util_rebuild_pdf_overlay.py 里读取）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# 或使用专用键（仅本仓库脚本会映射到上行变量）：
# TRANSLATE_HTTP_PROXY=http://127.0.0.1:7890
# TRANSLATE_HTTPS_PROXY=http://127.0.0.1:7890
# Google 翻译节流（秒，可选）
# GOOGLE_TRANSLATE_SLEEP=0.35
